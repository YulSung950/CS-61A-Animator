{"data":{"diff_size":223,"explanation":"git","new_content":"/** One-shot window Escape listener for dismissing the canvas error overlay. */\nexport function listenEscape(callback) {\n  window.addEventListener(\"keydown\", (event) => {\n    if (event.key === \"Escape\") callback();\n  });\n}\n","new_content_size":223,"new_hash":"3339e7c09bf419f72edeca79812e90a10bac19f9e1649196a71437db2eccb33d","old_hash":"","operation":"create","path":"src/app_ffi.mjs"},"hash":"245e8eff73737c8ddd5bc66dce6dece50cb15bd36849c78d85a8b696309fb354","kind":"fs.external_change","prev_hash":"0128e8905cbf368c4a7ca5e69a4312b92a3ed599b9333bb945720cf4a8dfbd8d","seq":278,"t":7108014,"wall":"2026-11-20T01:32:17.738Z"}
